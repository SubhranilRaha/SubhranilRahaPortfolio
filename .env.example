# Copy to .env.local and fill in. Never commit .env.local.

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# Hashnode
HASHNODE_PUBLICATION_HOST=yourname.hashnode.dev

# GitHub (public stats; token optional, raises rate limit)
GITHUB_USERNAME=SubhranilRaha
GITHUB_TOKEN=

# Upstash Redis (visit counter)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend (contact form)
RESEND_API_KEY=
CONTACT_TO_EMAIL=subhranilrahaofficial@gmail.com

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
